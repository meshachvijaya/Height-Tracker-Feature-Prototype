{%- comment -%}
  Product carousel snippet with dynamic products, title, image, and price.
  Desktop: 6 per view, Tablet: 4, Mobile: 2.5 (partial peek).
  
  Parameters:
  - collection: A Shopify collection object (e.g., collections.featured)
  - product_handles: Comma-separated product handles (e.g., "product-1,product-2,product-3")
  - variant_ids: Comma-separated variant IDs matching the order of product_handles (optional)
  - limit: Maximum number of products to show (default: 8)
  
  Usage examples:
  {% render 'product-carousel', collection: collections.featured %}
  {% render 'product-carousel', product_handles: 'product-1,product-2,product-3' %}
  {% render 'product-carousel', product_handles: 'calmagzinc-drink,calmagzinc-drink,calmagzinc-drink,calmagzinc-drink,young-ladies-glowup-pack,trial-set-kids,family-premium-package,gogrow-travel-set-1', variant_ids: '45739232395435,45739232428203,45739232460971,45739232493739,45766988464299,45766758662315,45768778317995,45766847004843' %}
{%- endcomment -%}

{%- liquid
  assign limit = limit | default: 8
  assign use_collection = false
  assign use_handles = false
  
  if collection != blank
    assign use_collection = true
  elsif product_handles != blank
    assign use_handles = true
    assign handles_array = product_handles | split: ','
    if variant_ids != blank
      assign variant_ids_array = variant_ids | split: ','
    endif
  endif
-%}

<style>
  .hm-carousel {
    position: relative;
  }
  .hm-carousel__track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 6px 0 10px;
    scroll-behavior: smooth;
  }
  .hm-carousel__track::-webkit-scrollbar {
    height: 6px;
  }
  .hm-carousel__track::-webkit-scrollbar-thumb {
    background: #ccc;
    border-radius: 999px;
  }
  .hm-carousel__slide {
    flex: 0 0 16.66%;
    scroll-snap-align: start;
  }
  .hm-carousel__card {
    display: block;
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
    background: #f8f8f8;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .hm-carousel__card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
  }
  .hm-carousel__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 1 / 1;
  }
  .hm-carousel__info {
    padding: 8px;
    text-align: center;
  }
  .hm-carousel__title {
    font-size: 14px;
    font-weight: 500;
    margin: 0 0 4px;
    color: #222;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hm-carousel__price {
    font-size: 16px;
    font-weight: 600;
    color: #222;
    margin: 0;
  }
  .hm-carousel__price--compare {
    text-decoration: line-through;
    color: #999;
    font-size: 14px;
    font-weight: 400;
    margin-right: 6px;
  }
  .hm-carousel__price--sale {
    color: #e53e3e;
  }
  .hm-carousel__btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid #ddd;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background 0.2s ease, box-shadow 0.2s ease;
  }
  .hm-carousel__btn:hover {
    background: #fff;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.12);
  }
  .hm-carousel__btn--prev { left: -10px; }
  .hm-carousel__btn--next { right: -10px; }

  @media (max-width: 1199px) {
    .hm-carousel__slide { flex-basis: 25%; }
  }
  @media (max-width: 767px) {
    .hm-carousel__slide { flex-basis: 40%; } /* ~2.5 items per view */
    .hm-carousel__btn { display: none; }
  }
</style>

<div class="hm-carousel" data-hm-carousel>
  <button type="button" class="hm-carousel__btn hm-carousel__btn--prev" data-hm-carousel-prev aria-label="Previous">
    ‹
  </button>
  <div class="hm-carousel__track" data-hm-carousel-track>
    {%- if use_collection -%}
      {%- for product in collection.products limit: limit -%}
        {%- liquid
          assign selected_variant = product.selected_or_first_available_variant
          assign price = selected_variant.price
          assign compare_at_price = selected_variant.compare_at_price
          assign show_compare_price = false
          if compare_at_price > price
            assign show_compare_price = true
          endif
        -%}
        <div class="hm-carousel__slide">
          <a class="hm-carousel__card" href="{{ product.url }}" title="{{ product.title | escape }}">
            {%- if product.featured_image != blank -%}
              <img
                class="hm-carousel__image"
                src="{{ product.featured_image | image_url: width: 400 }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                loading="lazy"
                width="400"
                height="400"
              >
            {%- else -%}
              <div class="hm-carousel__image" style="background: #f0f0f0; display: flex; align-items: center; justify-content: center;">
                <span style="color: #999;">No image</span>
              </div>
            {%- endif -%}
            <div class="hm-carousel__info">
              <h3 class="hm-carousel__title">{{ product.title }}</h3>
              <div class="hm-carousel__price">
                {%- if show_compare_price -%}
                  <span class="hm-carousel__price--compare">{{ compare_at_price | money }}</span>
                  <span class="hm-carousel__price--sale">{{ price | money }}</span>
                {%- else -%}
                  {{ price | money }}
                {%- endif -%}
              </div>
            </div>
          </a>
        </div>
      {%- endfor -%}
    {%- elsif use_handles -%}
      {%- assign count = 0 -%}
      {%- for handle in handles_array -%}
        {%- if count >= limit -%}
          {%- break -%}
        {%- endif -%}
        {%- assign handle_stripped = handle | strip -%}
        {%- assign product = all_products[handle_stripped] -%}
        {%- if product != blank -%}
          {%- assign count = count | plus: 1 -%}
          {%- liquid
            assign variant_id_index = count | minus: 1
            assign selected_variant = product.selected_or_first_available_variant
            assign product_url = product.url
            
            if variant_ids_array != blank and variant_ids_array[variant_id_index] != blank
              assign target_variant_id = variant_ids_array[variant_id_index] | strip | plus: 0
              for variant in product.variants
                if variant.id == target_variant_id
                  assign selected_variant = variant
                  assign product_url = product.url | append: '?variant=' | append: variant.id
                  break
                endif
              endfor
            endif
            
            assign price = selected_variant.price
            assign compare_at_price = selected_variant.compare_at_price
            assign show_compare_price = false
            if compare_at_price > price
              assign show_compare_price = true
            endif
          -%}
          <div class="hm-carousel__slide">
            <a class="hm-carousel__card" href="{{ product_url }}" title="{{ product.title | escape }}">
              {%- if product.featured_image != blank -%}
                <img
                  class="hm-carousel__image"
                  src="{{ product.featured_image | image_url: width: 400 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="400"
                  height="400"
                >
              {%- else -%}
                <div class="hm-carousel__image" style="background: #f0f0f0; display: flex; align-items: center; justify-content: center;">
                  <span style="color: #999;">No image</span>
                </div>
              {%- endif -%}
              <div class="hm-carousel__info">
                <h3 class="hm-carousel__title">{{ product.title }}</h3>
                <div class="hm-carousel__price">
                  {%- if show_compare_price -%}
                    <span class="hm-carousel__price--compare">{{ compare_at_price | money }}</span>
                    <span class="hm-carousel__price--sale">{{ price | money }}</span>
                  {%- else -%}
                    {{ price | money }}
                  {%- endif -%}
                </div>
              </div>
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
  <button type="button" class="hm-carousel__btn hm-carousel__btn--next" data-hm-carousel-next aria-label="Next">
    ›
  </button>
</div>

<script>
  (function () {
    const root = document.querySelector('[data-hm-carousel]');
    if (!root) return;

    const track = root.querySelector('[data-hm-carousel-track]');
    const prev = root.querySelector('[data-hm-carousel-prev]');
    const next = root.querySelector('[data-hm-carousel-next]');

    if (!track) return;

    const scrollAmount = () => track.clientWidth * 0.8;

    const scrollByAmount = (dir) => {
      track.scrollBy({ left: dir * scrollAmount(), behavior: 'smooth' });
    };

    prev?.addEventListener('click', () => scrollByAmount(-1));
    next?.addEventListener('click', () => scrollByAmount(1));
  })();
</script>

